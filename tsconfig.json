{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "*.config.ts"],
  "exclude": ["**/node_modules", "**/dist", "**/coverage"]
}
