{
  "name": "@nexo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate:up": "tsx src/shared/db/migrate.ts up",
    "db:migrate:down": "tsx src/shared/db/migrate.ts down"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
